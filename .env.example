# --- Database ---
DATABASE_URL=

# --- Session signing ---
# Any long random string. Required for both phase1 (email/password) sessions
# and the one-time super-admin bootstrap.
JWT_SECRET=

# --- Super-admin bootstrap ---
# Set this to a random secret, visit /admin-bootstrap once to create your
# super-admin account with it, then rotate or remove this value.
OWNER_SETUP_KEY=

# --- LLM (used for face/product photo analysis) ---
# Defaults to OpenRouter's free tier. Get a free key at https://openrouter.ai/keys
# then set OPENROUTER_API_KEY below. LLM_MODEL="openrouter/free" auto-picks a
# free model (including vision-capable ones for photo analysis).
# To use OpenAI instead: set OPENAI_API_KEY, LLM_BASE_URL=https://api.openai.com,
# LLM_MODEL=gpt-4o-mini (or leave LLM_BASE_URL/LLM_MODEL unset and OpenRouter's
# defaults below will be used).
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api
LLM_MODEL=openrouter/free

# --- File storage ---
# Local folder where uploaded photos/receipts are written.
STORAGE_DIR=./data/uploads

# --- Notifications (optional) ---
# Slack/Discord-style incoming webhook URL. If unset, notifications are
# just logged to the server console.
NOTIFY_WEBHOOK_URL=

# --- Client ---
# Only needed if the API isn't reachable by swapping port 8081->3000 on the
# current hostname (e.g. production behind a different domain).
EXPO_PUBLIC_API_BASE_URL=
