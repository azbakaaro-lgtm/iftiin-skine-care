# --- Database ---
DATABASE_URL=mysql://root:olPyoBsWEovVOxqtcUenOycjDKHlYcAi@mysql.railway.internal:3306/railway

# --- Session signing ---
# Any long random string. Required for both phase1 (email/password) sessions
# and the one-time super-admin bootstrap.
JWT_SECRET=iftiin-skin-care-jwt-2026-8fK9!xP2#Lm2@Qa8

# --- Super-admin bootstrap ---
# Set this to a random secret, visit /admin-bootstrap once to create your
# super-admin account with it, then rotate or remove this value.
OWNER_SETUP_KEY=IftiinOwner_2026#K9vP7xLm2Qz8R2nT8

# --- LLM (used for face/product photo analysis) ---
# Any OpenAI-compatible provider works. Defaults to https://api.openai.com.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini

# --- File storage ---
# Local folder where uploaded photos/receipts are written.
STORAGE_DIR=./data/uploads

# --- Notifications (optional) ---
# Slack/Discord-style incoming webhook URL. If unset, notifications are
# just logged to the server console.
NOTIFY_WEBHOOK_URL=

# --- Client ---
# Only needed if the API isn't reachable by swapping port 8081->3000 on the
# current hostname (e.g. production behind a different domain).
EXPO_PUBLIC_API_BASE_URL=
